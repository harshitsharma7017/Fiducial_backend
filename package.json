{
  "name": "fiducial-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for Fiducial, the property insurance placement platform",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:admin": "node --env-file-if-exists=.env src/scripts/seed-admin.ts",
    "import:masters": "node --env-file-if-exists=.env src/scripts/import-masters.ts",
    "clean:cases": "node --env-file-if-exists=.env src/scripts/clean-case-data.ts",
    "sync:stages": "node --env-file-if-exists=.env src/scripts/sync-stages.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "jszip": "3.10.2",
    "mongoose": "9.10.4",
    "nodemailer": "10.0.15",
    "pdfmake": "0.3.11",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pdfmake": "0.3.3",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.43"
    }
  }
}
