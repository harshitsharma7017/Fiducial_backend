# Copy to .env for local development. Never commit .env files.
NODE_ENV=development
PORT=4000

# The single-node replica set from docker-compose.yml (transactions need a replica set).
MONGODB_URI=mongodb://localhost:27017/property_erp?directConnection=true

# At least 32 characters. Generate a real one with: openssl rand -base64 48
# Values starting with "dev-only" are refused when NODE_ENV=production.
JWT_SECRET=dev-only-secret-replace-me-0123456789abcdef

# Access token lifetime in seconds; the web session lasts as long. 28800 = 8 hours.
JWT_EXPIRES_IN_SECONDS=28800

# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# Express "trust proxy". "loopback" trusts the Next.js server on the same machine, so the
# per-IP sign-in limit sees the browser's address. Set to your load balancer hops in production.
TRUST_PROXY=loopback

# Sign-in attempts allowed per IP per window (in addition to the per-account lockout).
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# GST applied to the Fire rating total.
GST_RATE_PERCENT=18

# Renewals: the policy administration software's public API, which gives last year's policy
# (see src/modules/proposals/existing-policy-source.ts for the request and answer expected).
# Leave the URL unset until it is available; renewals are then created without the Existing column.
# EXISTING_POLICY_API_URL=https://policies.example.com/api/v1
# EXISTING_POLICY_API_KEY=
# EXISTING_POLICY_API_TIMEOUT_MS=10000
# EXISTING_POLICY_SOURCE_NAME=PolicyDesk

# RFQ mail. outbox keeps every mail in the case's mail log without delivering it (development);
# smtp delivers through the server below; off refuses to send. Unset: outbox, but off when
# NODE_ENV=production, so a production server mails nobody until smtp is set on purpose.
MAIL_TRANSPORT=outbox
# The From address; required for smtp. Replies go to the user who sent the mail.
# MAIL_FROM=rfq@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true: TLS from the start (usually port 465); false: STARTTLS when the server offers it.
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Read only by `npm run seed:admin`. Prefer passing these on the command line instead of
# keeping a password in this file.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Administrator
